//@version=6
indicator("Triple VWMA & ATR Table (w/ Ranging Logic)", shorttitle="3VWMA+ATR+Rng", overlay=true, max_bars_back = 5000, max_lines_count = 400)

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================
getPosition(pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        "Quarter Left" => position.top_left
        "Quarter Right" => position.top_right
        => position.top_right

getRowOffset(pos) =>
    (pos == "Quarter Left" or pos == "Quarter Right") ? 6 : 0

getSize(sizeStr) =>
    switch sizeStr
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

// =============================================================================
// TRIPLE VWMA SETTINGS
// =============================================================================

// --- VWMA 1 Settings (Default: 20) ---
grp1 = "VWMA 1"
show1 = input.bool(true, "Show", group=grp1)
len1 = input.int(20, "Length", minval=1, group=grp1)
src1 = input.source(close, "Source", group=grp1)
offset1 = input.int(0, "Offset", minval=-500, maxval=500, group=grp1)
color1 = input.color(color.blue, "Color", group=grp1)

// --- VWMA 2 Settings (Default: 50) ---
grp2 = "VWMA 2"
show2 = input.bool(true, "Show", group=grp2)
len2 = input.int(50, "Length", minval=1, group=grp2)
src2 = input.source(close, "Source", group=grp2)
offset2 = input.int(0, "Offset", minval=-500, maxval=500, group=grp2)
color2 = input.color(color.orange, "Color", group=grp2)

// --- VWMA 3 Settings (Default: 200) ---
grp3 = "VWMA 3"
show3 = input.bool(true, "Show", group=grp3)
len3 = input.int(200, "Length", minval=1, group=grp3)
src3 = input.source(close, "Source", group=grp3)
offset3 = input.int(0, "Offset", minval=-500, maxval=500, group=grp3)
color3 = input.color(color.red, "Color", group=grp3)

// --- Trend Logic & Filters ---
grpTrend = "Trend Logic (VWMA 3)"
useVolFilter = input.bool(false, "Volume Surge Filter (> SMA 10)", group=grpTrend)
useAtrFilter = input.bool(false, "ATR Buffer Filter", group=grpTrend)
atrMult = input.float(0.5, "ATR Multiplier", minval=0.1, step=0.1, group=grpTrend)

// --- Ehlers TMA Settings ---
grpEhlers = "Ehlers TMA Settings"
ehlers_inp = input(title = 'Source', defval = hlcc4, group=grpEhlers)
ehlers_res = input.timeframe(title = 'Resolution', defval = '', group=grpEhlers)
ehlers_rep = input(title = 'Allow Repainting?', defval = false, group=grpEhlers)
ehlers_bar = input(title = 'Allow Bar Color Change?', defval = false, group=grpEhlers)
ehlers_length = input.int(title = 'Length', defval = 14, minval = 1, group=grpEhlers)
useEhlersFilter = input.bool(false, "Use Ehlers Filter (Strong Signals Only)", group=grpEhlers)

// --- RANGING LOGIC SETTINGS ---
grpRange = "Ranging / Flat Logic"
useChop = input.bool(true, "Use Choppiness Index (Reset Trend)", group=grpRange)
chopLen = input.int(14, "Choppiness Length", group=grpRange)
chopThresh = input.float(61.8, "Choppiness Threshold (Standard: 61.8)", group=grpRange)
useHug = input.bool(true, "Use VWMA Hug (Consolidation)", group=grpRange)
hugThresh = input.float(0.15, "Hug Threshold % (Dist from VWMA 3)", step=0.05, group=grpRange)

// --- MTF Dashboard Settings ---
grpMtf = "MTF Dashboard"
showMtf = input.bool(true, "Show Dashboard", group=grpMtf)
dashPosInput = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left", "Quarter Left", "Quarter Right"], group=grpMtf)
dashSizeInput = input.string("Small", "Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grpMtf)
dashTextColor = input.color(color.white, "Text Color", group=grpMtf)
dashBgColor = input.color(color.new(color.gray, 50), "Background Color", group=grpMtf)

tf1 = input.timeframe("60", "Timeframe 1", group=grpMtf)
tf2 = input.timeframe("240", "Timeframe 2", group=grpMtf)
tf3 = input.timeframe("D", "Timeframe 3", group=grpMtf)
tf4 = input.timeframe("W", "Timeframe 4", group=grpMtf)
tf5 = input.timeframe("M", "Timeframe 5", group=grpMtf)

// =============================================================================
// ATR TABLE & ADAPTIVE TRAIL SETTINGS
// =============================================================================
grpAtrDisplay = "ATR Table - Display"
showPrevATR = input.bool(true, title = 'Show Dynamic ATR Analysis Panel', group = grpAtrDisplay)
showATRDirection = input.bool(true, title = 'Show ATR Directional Tracking', group = grpAtrDisplay)
showMultiLevelTargets = input.bool(true, title = 'Show Multi-Level ATR Targets', group = grpAtrDisplay)
atrTablePosition = input.string("Bottom Right", title="ATR Table Position",
    options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right", "Quarter Left", "Quarter Right"],
    group = grpAtrDisplay)
atrTableSize = input.string("Small", title="ATR Table Text Size",
    options=["Tiny", "Small", "Normal", "Large", "Huge"], group = grpAtrDisplay)

grpAtrLogic = "ATR Table - Logic"
atrLength = input.int(14, title = 'ATR Length', minval = 1, group = grpAtrLogic)
pipMultiplier = input.float(10000, title = 'Pip Multiplier', group = grpAtrLogic,
    tooltip = '10000 for standard forex, 100 for JPY pairs, 1 for crypto', options=[1, 100, 10000])
enableATRAlerts = input.bool(true, title = 'Enable ATR Target Alerts', group = grpAtrLogic)

grpAdaptive = "Adaptive Session Trail"
showAdaptiveTrail = input.bool(true, "Show Adaptive Trail", group=grpAdaptive)
trailMultLow = input.float(3.0, "Early Session Multiplier", group=grpAdaptive)
trailMultMid = input.float(2.5, "Mid Session Multiplier (60-90%)", group=grpAdaptive)
trailMultHigh = input.float(1.5, "Exhaustion Multiplier (>90%)", group=grpAdaptive)
trailColorLong = input.color(color.lime, "Long Trail Color", group=grpAdaptive)
trailColorShort = input.color(color.red, "Short Trail Color", group=grpAdaptive)

// Session time settings for intraday (Kill Zones)
grpSessions = "Session Settings (EST)"
kzAsia = input.session("2000-0000", title="Asian Kill Zone", group=grpSessions)
kzLondon = input.session("0200-0500", title="London Open Kill Zone", group=grpSessions)
kzNY = input.session("0700-1000", title="NY Open Kill Zone", group=grpSessions)
kzLondonClose = input.session("1000-1200", title="London Close Kill Zone", group=grpSessions)

// =============================================================================
// SOP INFO PANEL SETTINGS
// =============================================================================
grpSop = "SOP Info Panel"
showSop = input.bool(true, "Show SOP Info Panel", group=grpSop)
sopPosInput = input.string("Bottom Left", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left", "Quarter Left", "Quarter Right"], group=grpSop)
sopSizeInput = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grpSop)
sopTextColor = input.color(color.white, "Text Color", group=grpSop)
sopBgColor = input.color(color.new(color.black, 30), "Background Color", group=grpSop)
colorEarly = color.new(color.aqua, 20)
colorLock = color.new(color.lime, 20)
colorExit = color.new(color.red, 20)
colorDim = color.new(color.gray, 70)

// =============================================================================
// BREAKOUT FINDER SETTINGS
// =============================================================================
grpBF = "Breakout Finder"
showBF = input.bool(true, "Show Breakout Finder", group=grpBF)
prd = input.int(defval = 5, title = 'Period', minval = 2, group=grpBF)
bo_len = input.int(defval = 200, title = 'Max Breakout Length', minval = 30, maxval = 300, group=grpBF)
cwidthu = input.float(defval = 3., title = 'Threshold Rate %', minval = 1., maxval = 10, group=grpBF) / 100
mintest = input.int(defval = 2, title = 'Minimum Number of Tests', minval = 1, group=grpBF)
bocolorup = input.color(defval = color.blue, title = 'Breakout Colors', inline = 'bocol', group=grpBF)
bocolordown = input.color(defval = color.red, title = '', inline = 'bocol', group=grpBF)
lstyle = input.string(defval = line.style_solid, title = 'Line Style', options = [line.style_solid, line.style_dashed, line.style_dotted], group=grpBF)

// =============================================================================
// BREAKOUT PROBABILITY SETTINGS
// =============================================================================
grpBP = "Breakout Probability"
showBP = input.bool(true, "Show Breakout Probability Lines", group=grpBP)
showBPTable = input.bool(false, "Show Probability Table", group=grpBP)
useBPFilter = input.bool(false, "Use Probability to Filter Signals", group=grpBP)
perc = input.float(1.0, title = 'Percentage Step', step = .1, minval = 0, group = grpBP)
nbr = input.int(5, title = 'Number of Lines', maxval = 5, minval = 1, group = grpBP)
upCol = input.color(color.new(color.green, 0), title = '', inline = 'colbp', group=grpBP)
dnCol = input.color(color.new(color.red, 0), title = '', inline = 'colbp', group=grpBP)
fill = input.bool(true, title = 'Fill Color', inline = 'colbp', group=grpBP)
bpPosInput = input.string("Middle Right", "BP Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left", "Quarter Left", "Quarter Right"], group=grpBP)

// =============================================================================
// EHLERS TMA CALCULATIONS
// =============================================================================
ehlers_src = request.security(syminfo.tickerid, ehlers_res, ehlers_inp[ehlers_rep ? 0 : barstate.isrealtime ? 1 : 0])[ehlers_rep ? 0 : barstate.isrealtime ? 0 : 1]
ehlers_filt = 0.0
ehlers_coef = 0.0
ehlers_l2 = ehlers_length / 2.0
for i = 1 to ehlers_length by 1
    c = i < ehlers_l2 ? i : i > ehlers_l2 ? ehlers_length + 1 - i : ehlers_l2
    ehlers_filt := ehlers_filt + c * nz(ehlers_src[i - 1])
    ehlers_coef := ehlers_coef + c
ehlers_filt := ehlers_coef != 0 ? ehlers_filt / ehlers_coef : 0

ehlers_slo = ehlers_src - ehlers_filt
ehlers_sig = ehlers_slo > 0 ? ehlers_slo > nz(ehlers_slo[1]) ? 2 : 1 : ehlers_slo < 0 ? ehlers_slo < nz(ehlers_slo[1]) ? -2 : -1 : 0

tmaColor = ehlers_sig > 1 ? color.green : ehlers_sig > 0 ? color.lime : ehlers_sig < -1 ? color.maroon : ehlers_sig < 0 ? color.red : color.white
barcolor(ehlers_bar ? tmaColor : na)
plot(ehlers_filt, title = 'Ehlers Tma', color = tmaColor, linewidth = 2)

// =============================================================================
// TRIPLE VWMA CALCULATIONS
// =============================================================================
vwma1 = ta.vwma(src1, len1)
vwma2 = ta.vwma(src2, len2)
vwma3 = ta.vwma(src3, len3)

plot(show1 ? vwma1 : na, title="VWMA 1", color=color1, offset=offset1)
plot(show2 ? vwma2 : na, title="VWMA 2", color=color2, offset=offset2)
plot(show3 ? vwma3 : na, title="VWMA 3", color=color3, offset=offset3)

// Filter Calculations
volSma = ta.sma(volume, 10)
volOk = not useVolFilter or (volume > volSma)

// ATR Buffer Logic
atrValFilter = ta.atr(14)
upperThreshold = useAtrFilter ? vwma3 + (atrValFilter * atrMult) : vwma3
lowerThreshold = useAtrFilter ? vwma3 - (atrValFilter * atrMult) : vwma3

// --- RANGING CALCULATIONS ---
log10(x) => math.log(x) / math.log(10)
atrSum = math.sum(ta.atr(1), chopLen)
highestHigh = ta.highest(chopLen)
lowestLow = ta.lowest(chopLen)
denom = highestHigh - lowestLow
ci = denom > 0 ? 100 * log10(atrSum / denom) / log10(chopLen) : 0
isChoppy = useChop and ci > chopThresh

distToVwma = math.abs(close - vwma3)
distPct = (distToVwma / vwma3) * 100
isHugging = useHug and distPct < hugThresh

isRanging = isChoppy or isHugging

// =============================================================================
// BREAKOUT PROBABILITY LOGIC
// =============================================================================
b_bp = bar_index
o_bp = open
h_bp = high
l_bp = low
c_bp = close
step_bp = c_bp * (perc / 100)

var total_bp = matrix.new<int>(7, 4, 0)
var vals_bp = matrix.new<float>(5, 4, 0.0)
var lines_bp = matrix.new<line>(1, 10, line(na))
var labels_bp = matrix.new<label>(1, 10, label(na))

green_bp = c_bp[1] > o_bp[1]
red_bp = c_bp[1] < o_bp[1]

if green_bp
    prev = matrix.get(total_bp, 5, 0)
    matrix.set(total_bp, 5, 0, prev + 1)
if red_bp
    prev = matrix.get(total_bp, 5, 1)
    matrix.set(total_bp, 5, 1, prev + 1)

Score(x, i) =>
    ghh = matrix.get(total_bp, i, 0)
    gll = matrix.get(total_bp, i, 1)
    rhh = matrix.get(total_bp, i, 2)
    rll = matrix.get(total_bp, i, 3)
    gtotal = matrix.get(total_bp, 5, 0)
    rtotal = matrix.get(total_bp, 5, 1)
    hh = h_bp >= h_bp[1] + x
    ll = l_bp <= l_bp[1] - x
    if green_bp and hh
        matrix.set(total_bp, i, 0, ghh + 1)
        matrix.set(vals_bp, i, 0, math.round((ghh + 1) / gtotal * 100, 2))
    if green_bp and ll
        matrix.set(total_bp, i, 1, gll + 1)
        matrix.set(vals_bp, i, 1, math.round((gll + 1) / gtotal * 100, 2))
    if red_bp and hh
        matrix.set(total_bp, i, 2, rhh + 1)
        matrix.set(vals_bp, i, 2, math.round((rhh + 1) / rtotal * 100, 2))
    if red_bp and ll
        matrix.set(total_bp, i, 3, rll + 1)
        matrix.set(vals_bp, i, 3, math.round((rll + 1) / rtotal * 100, 2))

Score(0, 0)
Score(step_bp, 1)
Score(step_bp * 2, 2)
Score(step_bp * 3, 3)
Score(step_bp * 4, 4)

a1_bp = matrix.get(vals_bp, 0, 0) // Green High
b1_bp = matrix.get(vals_bp, 0, 1) // Green Low
a2_bp = matrix.get(vals_bp, 0, 2) // Red High
b2_bp = matrix.get(vals_bp, 0, 3) // Red Low

// Calculate Bias based on current candle start color match
probBull = green_bp ? a1_bp : a2_bp
probBear = green_bp ? b1_bp : b2_bp
bpCondition = probBull > probBear // Basic logic: if odds of Higher are better than Lower

// BP Table
if showBP and showBPTable and barstate.islast
    bpOffset = getRowOffset(bpPosInput)
    var tbl_bp = table.new(getPosition(bpPosInput), 2, 3 + bpOffset, frame_color = color.new(color.gray, 50), frame_width = 3, border_color = chart.bg_color, border_width = -2)
    W = matrix.get(total_bp, 6, 0)
    L = matrix.get(total_bp, 6, 1)
    WR = (W + L) > 0 ? math.round(W / (W + L) * 100, 2) : 0
    table.cell(tbl_bp, 0, 0 + bpOffset, 'WIN: ' + str.tostring(W), text_halign = text.align_center, bgcolor = chart.bg_color, text_color = color.green)
    table.cell(tbl_bp, 0, 1 + bpOffset, 'LOSS: ' + str.tostring(L), text_halign = text.align_center, bgcolor = chart.bg_color, text_color = color.red)
    table.cell(tbl_bp, 0, 2 + bpOffset, 'Ratio: ' + str.tostring(WR) + '%', text_halign = text.align_center, bgcolor = chart.bg_color, text_color = chart.fg_color)

// BP Lines & Labels (Only if showBP)
CreateLine(p, i, c, visible) =>
    prevLine = matrix.get(lines_bp, 0, i)
    line.delete(prevLine)
    if visible
        li = line.new(b_bp[1], p, b_bp, p, color = c, width = 2)
        matrix.set(lines_bp, 0, i, li)

CreateLabel(p, i, c, r, v, visible) =>
    prevLabel = matrix.get(labels_bp, 0, i)
    label.delete(prevLabel)
    if visible
        la = label.new(b_bp + 1, p, text = str.tostring(matrix.get(vals_bp, r, v), format.percent), style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
        matrix.set(labels_bp, 0, i, la)

// Call unconditionally to avoid warnings
// Iterate through fixed max size (5) to ensure consistency
for i = 0 to 4 by 1
    // Calculate positions regardless of visibility (low cost)
    hi = h_bp[1] + step_bp * i
    lo = l_bp[1] - step_bp * i

    // Determine visibility based on configured number of lines
    isVisible = showBP and i < nbr

    // Pass visibility state to drawing functions
    CreateLine(hi, i, upCol, isVisible)
    CreateLine(lo, 5 + i, dnCol, isVisible)

    if green_bp
        CreateLabel(hi, i, upCol, i, 0, isVisible)
        CreateLabel(lo, 5 + i, dnCol, i, 1, isVisible)
    else
        CreateLabel(hi, i, upCol, i, 2, isVisible)
        CreateLabel(lo, 5 + i, dnCol, i, 3, isVisible)

// Fill
if showBP and fill
    var filler = linefill(na)
    for i = 0 to 8 by 1
        get = matrix.get(lines_bp, 0, i)
        get1 = matrix.get(lines_bp, 0, i + 1)
        col = i > 4 ? color.new(dnCol, 80) : i == 4 ? color.new(color.gray, 100) : color.new(upCol, 80)
        filler := linefill.new(get, get1, color = col)
        linefill.delete(filler[1])

// =============================================================================
// TREND TRIGGER LOGIC (INTEGRATED)
// =============================================================================
var int currentTrend = 0
breakUp = open[1] < vwma3[1] and close[1] > vwma3[1]
breakDown = open[1] > vwma3[1] and close[1] < vwma3[1]
confirmUp = close > upperThreshold
confirmDown = close < lowerThreshold

// Updated Triggers with BP Filter
bpFilterBuy = not useBPFilter or probBull > 50
bpFilterSell = not useBPFilter or probBear > 50

// Ehlers Filter
ehlersFilterBuy = not useEhlersFilter or ehlers_sig == 2
ehlersFilterSell = not useEhlersFilter or ehlers_sig == -2

triggerBuy = breakUp and confirmUp and volOk and not isRanging and bpFilterBuy and ehlersFilterBuy
triggerSell = breakDown and confirmDown and volOk and not isRanging and bpFilterSell and ehlersFilterSell

if isRanging
    currentTrend := 0
else if triggerBuy
    currentTrend := 1
else if triggerSell
    currentTrend := -1

// =============================================================================
// MTF DASHBOARD
// =============================================================================
[mtf1_vwma, mtf1_close] = request.security(syminfo.tickerid, tf1, [ta.vwma(src3, len3), close])
[mtf2_vwma, mtf2_close] = request.security(syminfo.tickerid, tf2, [ta.vwma(src3, len3), close])
[mtf3_vwma, mtf3_close] = request.security(syminfo.tickerid, tf3, [ta.vwma(src3, len3), close])
[mtf4_vwma, mtf4_close] = request.security(syminfo.tickerid, tf4, [ta.vwma(src3, len3), close])
[mtf5_vwma, mtf5_close] = request.security(syminfo.tickerid, tf5, [ta.vwma(src3, len3), close])

getTrendStatus(cls, vwm) =>
    dist = math.abs(cls - vwm)
    pct = (dist / vwm) * 100
    if pct < 0.1
        "FLAT"
    else
        cls > vwm ? "BULL" : "BEAR"

getTrendColor(status) =>
    if status == "FLAT"
        color.gray
    else if status == "BULL"
        color.green
    else
        color.red

dashPos = getPosition(dashPosInput)
mtfOffset = getRowOffset(dashPosInput)
dashSize = getSize(dashSizeInput)
var table mtfTable = table.new(dashPos, 2, 6 + mtfOffset, border_width=1)

if showMtf and barstate.islast
    // Force Spacer Rows if Offset is used
    if mtfOffset > 0
        for i = 0 to mtfOffset - 1
            table.cell(mtfTable, 0, i, "", height=4, bgcolor=color.new(color.black, 100))

    table.cell(mtfTable, 0, 0 + mtfOffset, "MTF", bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)
    table.cell(mtfTable, 1, 0 + mtfOffset, "Trend", bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)

    s1 = getTrendStatus(mtf1_close, mtf1_vwma)
    s2 = getTrendStatus(mtf2_close, mtf2_vwma)
    s3 = getTrendStatus(mtf3_close, mtf3_vwma)
    s4 = getTrendStatus(mtf4_close, mtf4_vwma)
    s5 = getTrendStatus(mtf5_close, mtf5_vwma)

    table.cell(mtfTable, 0, 1 + mtfOffset, tf1, bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)
    table.cell(mtfTable, 1, 1 + mtfOffset, s1, bgcolor=getTrendColor(s1), text_color=color.white, text_size=dashSize)
    table.cell(mtfTable, 0, 2 + mtfOffset, tf2, bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)
    table.cell(mtfTable, 1, 2 + mtfOffset, s2, bgcolor=getTrendColor(s2), text_color=color.white, text_size=dashSize)
    table.cell(mtfTable, 0, 3 + mtfOffset, tf3, bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)
    table.cell(mtfTable, 1, 3 + mtfOffset, s3, bgcolor=getTrendColor(s3), text_color=color.white, text_size=dashSize)
    table.cell(mtfTable, 0, 4 + mtfOffset, tf4, bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)
    table.cell(mtfTable, 1, 4 + mtfOffset, s4, bgcolor=getTrendColor(s4), text_color=color.white, text_size=dashSize)
    table.cell(mtfTable, 0, 5 + mtfOffset, tf5, bgcolor=dashBgColor, text_color=dashTextColor, text_size=dashSize)
    table.cell(mtfTable, 1, 5 + mtfOffset, s5, bgcolor=getTrendColor(s5), text_color=color.white, text_size=dashSize)

// =============================================================================
// CONSOLIDATED ATR & SESSION LOGIC
// =============================================================================

// -----------------------------------------------------------------------------
// SECTION 1: SESSION DETECTION & TRACKING
// -----------------------------------------------------------------------------

// Helper to check if current bar is in specified session (EST timezone)
isInSession(sess) =>
    not na(time(timeframe.period, sess, "America/New_York"))

// Detect active sessions
getActiveSession() =>
    inAsia = isInSession(kzAsia)
    inLondon = isInSession(kzLondon)
    inNY = isInSession(kzNY)
    inLondonClose = isInSession(kzLondonClose)

    sessionName = "Off-Hours"
    if inAsia
        sessionName := "Asian Kill Zone"
    else if inLondon
        sessionName := "London Open Kill Zone"
    else if inNY
        sessionName := "NY Open Kill Zone"
    else if inLondonClose
        sessionName := "London Close Kill Zone"

    isActive = inAsia or inLondon or inNY or inLondonClose
    [sessionName, isActive, inAsia, inLondon, inNY, inLondonClose]

[activeSessionName, isAnySession, inAsia, inLondon, inNY, inLondonClose] = getActiveSession()

// Track session range (High/Low/Open)
trackSessionRange() =>
    var float sessionOpen = na
    var float sessionHigh = na
    var float sessionLow = na
    var bool newSession = false

    wasActive = isAnySession[1]
    newSession := activeSessionName != activeSessionName[1] and activeSessionName != "Off-Hours"

    if newSession or barstate.isfirst
        sessionOpen := open
        sessionHigh := high
        sessionLow := low
    else
        sessionHigh := math.max(nz(sessionHigh, high), high)
        sessionLow := math.min(nz(sessionLow, low), low)

    // Initialize if never in session
    if not isAnySession and not wasActive and na(sessionOpen)
        sessionOpen := open

    [sessionOpen, sessionHigh, sessionLow, newSession]

[activeSessionOpen, sessHigh, sessLow, newSess] = trackSessionRange()

// -----------------------------------------------------------------------------
// SECTION 2: TIMEFRAME DETECTION & ATR CALCULATIONS
// -----------------------------------------------------------------------------

// Detect current timeframe type
isMonthly = timeframe.ismonthly
isWeekly = timeframe.isweekly
isDaily = timeframe.isdaily
isIntraday = timeframe.isintraday

getCurrentMinutes() =>
    if timeframe.isminutes
        timeframe.multiplier
    else if timeframe.isseconds
        timeframe.multiplier / 60
    else
        0

currentMinutes = getCurrentMinutes()
isHourly = isIntraday and currentMinutes >= 60 and currentMinutes < 1440
is4Hour = currentMinutes == 240
isMinuteBased = isIntraday and currentMinutes > 0 and currentMinutes < 60

// Determine optimal ATR timeframe based on chart timeframe
getATRTimeframe() =>
    if isMonthly
        "M"
    else if isWeekly
        "W"
    else if isDaily
        "D"
    else if is4Hour or isHourly
        "240"
    else if isMinuteBased
        timeframe.period
    else
        "D"

atrTimeframe = getATRTimeframe()

// Fetch ATR data from appropriate timeframe
[periodOpen, periodATR, period_atr_prev, period_atr_current] = request.security(
    syminfo.tickerid,
    atrTimeframe,
    [open, ta.atr(atrLength), ta.atr(atrLength)[1], ta.atr(atrLength)],
    lookahead = barmerge.lookahead_off)

// Use session open during kill zones, otherwise period open
referenceOpen = isAnySession ? activeSessionOpen : periodOpen
referenceATR = periodATR
atrMeanPips = referenceATR * pipMultiplier

// -----------------------------------------------------------------------------
// SECTION 3: ATR TARGET LEVELS
// -----------------------------------------------------------------------------

// Get dynamic target multipliers based on timeframe
getTargetMultipliers() =>
    if isMonthly
        [0.5, 1.0, 1.5, 2.0]
    else if isWeekly
        [0.5, 0.75, 1.0, 1.5]
    else if isDaily
        [0.5, 0.75, 1.0, 1.5]
    else if isHourly or is4Hour
        [0.3, 0.5, 0.75, 1.0]
    else
        [0.25, 0.5, 0.75, 1.0]

[mult1, mult2, mult3, mult4] = getTargetMultipliers()

// Calculate bullish and bearish targets
upperTarget_1 = referenceOpen + (referenceATR * mult1)
upperTarget_2 = referenceOpen + (referenceATR * mult2)
upperTarget_3 = referenceOpen + (referenceATR * mult3)
upperTarget_4 = referenceOpen + (referenceATR * mult4)

lowerTarget_1 = referenceOpen - (referenceATR * mult1)
lowerTarget_2 = referenceOpen - (referenceATR * mult2)
lowerTarget_3 = referenceOpen - (referenceATR * mult3)
lowerTarget_4 = referenceOpen - (referenceATR * mult4)

// -----------------------------------------------------------------------------
// SECTION 4: COMPLETION METRICS (Session/ATR/Scalp)
// -----------------------------------------------------------------------------

// Calculate session range completion vs daily ATR
sessionRange = sessHigh - sessLow
if na(sessionRange)
    sessionRange := high - low

dailyATR = request.security(syminfo.tickerid, "D", ta.atr(14))
sessionRangeCompletion = dailyATR != 0 ? (sessionRange / dailyATR) * 100 : 0

// Calculate directional ATR completion
moveFromOpen = math.abs(close - referenceOpen)
percentReached = referenceATR != 0 ? (moveFromOpen / referenceATR) * 100 : 0
bullishMove = (close > referenceOpen) ? (close - referenceOpen) * pipMultiplier : 0
bearishMove = (close < referenceOpen) ? (referenceOpen - close) * pipMultiplier : 0
currentDirectionalPips = bullishMove > 0 ? bullishMove : bearishMove
targetReached = currentDirectionalPips >= atrMeanPips

// Scalp drive completion (1-min based for off-hours)
[m1Close, m1High, m1Low, m1Vwma5, m1Vwma21] = request.security(
    syminfo.tickerid, "1",
    [close, high, low, ta.vwma(close, 5), ta.vwma(close, 21)])

m15ATR = request.security(syminfo.tickerid, "15", ta.atr(14))
m1Trend = m1Vwma5 > m1Vwma21 ? 1 : -1
m1TrendChanged = m1Trend != m1Trend[1]

var float m1DriveOrigin = na
if m1TrendChanged
    m1DriveOrigin := m1Trend == 1 ? m1Low : m1High
else
    if m1Trend == 1
        m1DriveOrigin := math.min(nz(m1DriveOrigin, m1Low), m1Low)
    else
        m1DriveOrigin := math.max(nz(m1DriveOrigin, m1High), m1High)

driveDist = math.abs(m1Close - m1DriveOrigin)
scalpCompletion = m15ATR != 0 ? (driveDist / m15ATR) * 100 : 0

// -----------------------------------------------------------------------------
// SECTION 5: ADAPTIVE TRAILING STOP
// -----------------------------------------------------------------------------

// Get M5 ATR for trail calculations
atrM5 = request.security(syminfo.tickerid, "5", ta.atr(14))

// Adaptive trail multiplier based on session completion
var float trailMult = trailMultLow
if sessionRangeCompletion < 60
    trailMult := trailMultLow         // Early phase: wider stops
else if sessionRangeCompletion >= 60 and sessionRangeCompletion < 90
    trailMult := trailMultMid         // Lock-in phase: tighter stops
else
    trailMult := trailMultHigh        // Exhaustion: tightest stops

// Calculate trailing stop price
var float trailPrice = na
if currentTrend == 0
    trailPrice := na
else if triggerBuy
    trailPrice := low - (atrM5 * trailMult)
else if triggerSell
    trailPrice := high + (atrM5 * trailMult)
else if currentTrend == 1
    peak = high
    calcTrail = peak - (atrM5 * trailMult)
    trailPrice := na(trailPrice) ? calcTrail : math.max(trailPrice, calcTrail)
else if currentTrend == -1
    peak = low
    calcTrail = peak + (atrM5 * trailMult)
    trailPrice := na(trailPrice) ? calcTrail : math.min(trailPrice, calcTrail)

colorTrail = currentTrend == 1 ? trailColorLong : trailColorShort
plot(showAdaptiveTrail and currentTrend != 0 ? trailPrice : na, "Adaptive Trail", color=colorTrail, style=plot.style_linebr, linewidth=2)

trailExit = (currentTrend == 1 and close < trailPrice) or (currentTrend == -1 and close > trailPrice)

// -----------------------------------------------------------------------------
// SECTION 6: ATR TABLE DISPLAY
// -----------------------------------------------------------------------------

// Helper function to get progress-based color
getProgressColor(percent) =>
    if percent < 25
        color.new(color.gray, 40)
    else if percent < 50
        color.new(color.blue, 40)
    else if percent < 75
        color.new(color.orange, 40)
    else if percent < 100
        color.new(color.yellow, 40)
    else
        color.new(color.green, 40)

atrOffset = getRowOffset(atrTablePosition)
atrSize = getSize(atrTableSize)

// Dynamic row count based on enabled features
baseRows = 3  // Header + Prev ATR + Current ATR
directionRows = showATRDirection ? 4 : 0
sessionRow = (showATRDirection and isIntraday and (isHourly or is4Hour)) ? 1 : 0
targetRows = (showATRDirection and showMultiLevelTargets) ? 4 : 0
totalRows = baseRows + directionRows + sessionRow + targetRows + atrOffset

var table atr_table = table.new(getPosition(atrTablePosition), 2, totalRows, border_width=1)

if barstate.islast and showPrevATR
    row = 0 + atrOffset

    // === HEADER ===
    headerText = activeSessionName != "Off-Hours"
                 ? "📊 " + activeSessionName
                 : isMinuteBased
                   ? str.format("📊 {0}M ATR", currentMinutes)
                   : "📊 ATR ANALYSIS"

    table.cell(atr_table, 0, row, headerText,
               bgcolor=color.new(#2962FF, 20),
               text_color=color.white,
               text_size=atrSize)
    table.merge_cells(atr_table, 0, row, 1, row)
    row += 1

    // === CORE METRICS ===
    table.cell(atr_table, 0, row, "Prev Period ATR",
               bgcolor=color.new(color.gray, 80),
               text_color=color.white,
               text_size=atrSize)
    table.cell(atr_table, 1, row,
               str.format('{0, number, #.#####}', period_atr_prev),
               bgcolor=color.new(color.black, 10),
               text_color=color.yellow,
               text_size=atrSize)
    row += 1

    atr_change = period_atr_current - period_atr_prev
    atr_change_pct = period_atr_prev != 0 ? (atr_change / period_atr_prev) * 100 : 0
    atr_momentum_color = atr_change > 0 ? color.new(color.red, 60) : color.new(color.green, 60)
    atr_icon = atr_change > 0 ? "↑" : "↓"

    table.cell(atr_table, 0, row, "ATR Momentum",
               bgcolor=color.new(color.gray, 80),
               text_color=color.white,
               text_size=atrSize)
    table.cell(atr_table, 1, row,
               str.format('{0} {1, number, +#.##;-#.##}%', atr_icon, atr_change_pct),
               bgcolor=atr_momentum_color,
               text_color=color.white,
               text_size=atrSize)
    row += 1

    // === DIRECTIONAL SECTION ===
    if showATRDirection
        // Separator
        table.cell(atr_table, 0, row, "🎯 POSITION STATUS",
                   bgcolor=color.new(color.purple, 70),
                   text_color=color.white,
                   text_size=atrSize)
        table.merge_cells(atr_table, 0, row, 1, row)
        row += 1

        // Current Direction
        direction_color = bullishMove > 0 ? color.new(color.green, 30) : color.new(color.red, 30)
        direction_icon = bullishMove > 0 ? "▲ BULL" : "▼ BEAR"

        table.cell(atr_table, 0, row, "Direction",
                   bgcolor=color.new(color.gray, 80),
                   text_color=color.white,
                   text_size=atrSize)
        table.cell(atr_table, 1, row,
                   str.format('{0} ({1, number, #.##} pips)', direction_icon, currentDirectionalPips),
                   bgcolor=direction_color,
                   text_color=color.white,
                   text_size=atrSize)
        row += 1

        // Progress Bar
        pct_color = getProgressColor(percentReached)
        progress_icon = percentReached >= 100 ? "✓" :
                        percentReached >= 75 ? "●●●○" :
                        percentReached >= 50 ? "●●○○" :
                        percentReached >= 25 ? "●○○○" : "○○○○"

        table.cell(atr_table, 0, row, "Progress",
                   bgcolor=color.new(color.gray, 80),
                   text_color=color.white,
                   text_size=atrSize)
        table.cell(atr_table, 1, row,
                   str.format('{0} {1, number, #.#}%', progress_icon, percentReached),
                   bgcolor=pct_color,
                   text_color=color.white,
                   text_size=atrSize)
        row += 1

        // Phase
        phase_text = sessionRangeCompletion < 60 ? "🔵 EARLY" :
                     sessionRangeCompletion < 90 ? "🟢 LOCK" : "🔴 EXIT"
        phase_color = sessionRangeCompletion < 60 ? color.new(color.aqua, 40) :
                      sessionRangeCompletion < 90 ? color.new(color.lime, 40) :
                                                     color.new(color.red, 40)

        table.cell(atr_table, 0, row, "Phase",
                   bgcolor=color.new(color.gray, 80),
                   text_color=color.white,
                   text_size=atrSize)
        table.cell(atr_table, 1, row,
                   str.format('{0} ({1, number, #}%)', phase_text, sessionRangeCompletion),
                   bgcolor=phase_color,
                   text_color=color.white,
                   text_size=atrSize)
        row += 1

        // Active Session (only for intraday)
        if isIntraday and (isHourly or is4Hour)
            session_color = inNY ? color.new(color.blue, 30) :
                           inLondon ? color.new(color.green, 30) :
                           inAsia ? color.new(color.yellow, 30) :
                                   color.new(color.gray, 50)

            table.cell(atr_table, 0, row, "Active Session",
                       bgcolor=color.new(color.gray, 80),
                       text_color=color.white,
                       text_size=atrSize)
            table.cell(atr_table, 1, row, activeSessionName,
                       bgcolor=session_color,
                       text_color=color.white,
                       text_size=atrSize)
            row += 1

        // === TARGET LEVELS ===
        if showMultiLevelTargets
            // Separator
            table.cell(atr_table, 0, row, "🎲 ATR TARGETS",
                       bgcolor=color.new(color.blue, 60),
                       text_color=color.white,
                       text_size=atrSize)
            table.merge_cells(atr_table, 0, row, 1, row)
            row += 1

            bullish_direction = close > referenceOpen
            target_1_hit = bullish_direction ? high >= upperTarget_1 : low <= lowerTarget_1
            target_2_hit = bullish_direction ? high >= upperTarget_2 : low <= lowerTarget_2
            target_3_hit = bullish_direction ? high >= upperTarget_3 : low <= lowerTarget_3
            target_4_hit = bullish_direction ? high >= upperTarget_4 : low <= lowerTarget_4

            // Inline logic to avoid nested function restriction
            // T1
            pipsLeft1 = bullish_direction
                       ? ((bullish_direction ? upperTarget_1 : lowerTarget_1) - close) * pipMultiplier
                       : (close - (bullish_direction ? upperTarget_1 : lowerTarget_1)) * pipMultiplier

            statusText1 = target_1_hit ? "✓ HIT" : str.format('{0, number, #.##} left', math.abs(pipsLeft1))
            bgColor1 = target_1_hit ? color.new(color.green, 40) : color.new(color.gray, 60)

            table.cell(atr_table, 0, row, str.format("{0}x Target", mult1), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=atrSize)
            table.cell(atr_table, 1, row, statusText1, bgcolor=bgColor1, text_color=color.white, text_size=atrSize)
            row += 1

            // T2
            pipsLeft2 = bullish_direction
                       ? ((bullish_direction ? upperTarget_2 : lowerTarget_2) - close) * pipMultiplier
                       : (close - (bullish_direction ? upperTarget_2 : lowerTarget_2)) * pipMultiplier

            statusText2 = target_2_hit ? "✓ HIT" : str.format('{0, number, #.##} left', math.abs(pipsLeft2))
            bgColor2 = target_2_hit ? color.new(color.green, 40) : color.new(color.gray, 60)

            table.cell(atr_table, 0, row, str.format("{0}x Target", mult2), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=atrSize)
            table.cell(atr_table, 1, row, statusText2, bgcolor=bgColor2, text_color=color.white, text_size=atrSize)
            row += 1

            // T3
            pipsLeft3 = bullish_direction
                       ? ((bullish_direction ? upperTarget_3 : lowerTarget_3) - close) * pipMultiplier
                       : (close - (bullish_direction ? upperTarget_3 : lowerTarget_3)) * pipMultiplier

            statusText3 = target_3_hit ? "✓ HIT" : str.format('{0, number, #.##} left', math.abs(pipsLeft3))
            bgColor3 = target_3_hit ? color.new(color.green, 40) : color.new(color.gray, 60)

            table.cell(atr_table, 0, row, str.format("{0}x Target", mult3), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=atrSize)
            table.cell(atr_table, 1, row, statusText3, bgcolor=bgColor3, text_color=color.white, text_size=atrSize)
            row += 1

            // T4
            pipsLeft4 = bullish_direction
                       ? ((bullish_direction ? upperTarget_4 : lowerTarget_4) - close) * pipMultiplier
                       : (close - (bullish_direction ? upperTarget_4 : lowerTarget_4)) * pipMultiplier

            statusText4 = target_4_hit ? "✓ HIT" : str.format('{0, number, #.##} left', math.abs(pipsLeft4))
            bgColor4 = target_4_hit ? color.new(color.green, 40) : color.new(color.gray, 60)

            table.cell(atr_table, 0, row, str.format("{0}x Target", mult4), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=atrSize)
            table.cell(atr_table, 1, row, statusText4, bgcolor=bgColor4, text_color=color.white, text_size=atrSize)
            row += 1

// -----------------------------------------------------------------------------
// SECTION 7: SOP INFO PANEL (Enhanced)
// -----------------------------------------------------------------------------

sopPos = getPosition(sopPosInput)
sopOffset = getRowOffset(sopPosInput)
sopSize = getSize(sopSizeInput)
isScalpMode = activeSessionName == "Off-Hours"

var table sopTable = table.new(sopPos, 2, 5 + sopOffset, border_width=1)

if showSop and barstate.islast
    row = 0 + sopOffset

    // Status Header
    statusText = isScalpMode ? ">> SCALP MODE <<" : ">> SESSION MODE <<"
    statusColor = isScalpMode ? color.new(color.orange, 20) : color.new(color.lime, 20)

    table.cell(sopTable, 0, row, "CURRENT STATUS:",
               bgcolor=color.new(color.black, 10),
               text_color=color.white,
               text_size=sopSize)
    table.cell(sopTable, 1, row, statusText,
               bgcolor=statusColor,
               text_color=color.white,
               text_size=sopSize)
    row += 1

    // Column Headers
    table.cell(sopTable, 0, row, "ANALYSIS TYPE",
               bgcolor=color.new(color.blue, 30),
               text_color=color.white,
               text_size=sopSize)
    table.cell(sopTable, 1, row, "TREND | PHASE (%)",
               bgcolor=color.new(color.blue, 30),
               text_color=color.white,
               text_size=sopSize)
    row += 1

    // Swing Analysis Row
    rowBgSwing = isScalpMode ? colorDim : color.new(color.green, 90)
    textAlphaSwing = isScalpMode ? 50 : 0

    table.cell(sopTable, 0, row, "SWING (SESSION)",
               bgcolor=rowBgSwing,
               text_color=color.new(color.white, textAlphaSwing),
               text_size=sopSize)

    iconSwing = currentTrend == 1 ? "🟢 BULL" :
                currentTrend == -1 ? "🔴 BEAR" : "⚪ FLAT"

    txtSwing = sessionRangeCompletion < 60 ? "Early" :
               sessionRangeCompletion < 90 ? "Lock" : "Exit"

    swingContent = iconSwing + " | " + txtSwing +
                   " (" + str.tostring(sessionRangeCompletion, "#") + "%)"

    if currentTrend == 0
        swingContent := "⚪ FLAT | " + (isChoppy ? "CHOP" : "CONSOL")

    table.cell(sopTable, 1, row, swingContent,
               bgcolor=rowBgSwing,
               text_color=color.new(color.white, textAlphaSwing),
               text_size=sopSize)
    row += 1

    // Scalp Analysis Row
    rowBgScalp = isScalpMode ? color.new(color.purple, 80) : colorDim
    textAlphaScalp = isScalpMode ? 0 : 50

    table.cell(sopTable, 0, row, "SCALP (1-MIN)",
               bgcolor=rowBgScalp,
               text_color=color.new(color.white, textAlphaScalp),
               text_size=sopSize)

    iconScalp = m1Trend == 1 ? "🟢 BULL" : "🔴 BEAR"
    txtScalp = scalpCompletion < 40 ? "Early" :
               scalpCompletion < 80 ? "Hold" : "Exhaust"

    scalpContent = iconScalp + " | " + txtScalp +
                   " (" + str.tostring(scalpCompletion, "#") + "%)"

    table.cell(sopTable, 1, row, scalpContent,
               bgcolor=rowBgScalp,
               text_color=color.new(color.white, textAlphaScalp),
               text_size=sopSize)
    row += 1

    // Footer
    footerText = isScalpMode
                 ? "Focus: Counter-Trend or Scalp Drives"
                 : "Focus: Trend Extension & Trail Management"

    table.merge_cells(sopTable, 0, row, 1, row)
    table.cell(sopTable, 0, row, footerText,
               bgcolor=color.new(color.gray, 30),
               text_color=color.white,
               text_size=size.tiny)

// =============================================================================
// BREAKOUT FINDER LOGIC
// =============================================================================
lll = math.max(math.min(bar_index, 300), 1)
float h_ = ta.highest(lll)
float l_ = ta.lowest(lll)
float chwidth = (h_ - l_) * cwidthu
ph = ta.pivothigh(prd, prd)
pl = ta.pivotlow(prd, prd)

var phval = array.new_float(0)
var phloc = array.new_int(0)
var plval = array.new_float(0)
var plloc = array.new_int(0)

if not na(ph)
    array.unshift(phval, ph)
    array.unshift(phloc, bar_index - prd)
    if array.size(phval) > 1
        for x = array.size(phloc) - 1 to 1 by 1
            if bar_index - array.get(phloc, x) > bo_len
                array.pop(phloc)
                array.pop(phval)

if not na(pl)
    array.unshift(plval, pl)
    array.unshift(plloc, bar_index - prd)
    if array.size(plval) > 1
        for x = array.size(plloc) - 1 to 1 by 1
            if bar_index - array.get(plloc, x) > bo_len
                array.pop(plloc)
                array.pop(plval)

float bomax = na
int bostart = bar_index
num = 0
hgst = ta.highest(prd)[1]
if array.size(phval) >= mintest and close > open and close > hgst
    bomax := array.get(phval, 0)
    xx = 0
    for x = 0 to array.size(phval) - 1 by 1
        if array.get(phval, x) >= close
            break
        xx := x
        bomax := math.max(bomax, array.get(phval, x))
    if xx >= mintest and open <= bomax
        for x = 0 to xx by 1
            if array.get(phval, x) <= bomax and array.get(phval, x) >= bomax - chwidth
                num := num + 1
                bostart := array.get(phloc, x)
        if num < mintest or hgst >= bomax
            bomax := na

float bomin = na
bostart1 = bar_index
num1 = 0
lwst = ta.lowest(prd)[1]
if array.size(plval) >= mintest and close < open and close < lwst
    bomin := array.get(plval, 0)
    xx = 0
    for x = 0 to array.size(plval) - 1 by 1
        if array.get(plval, x) <= close
            break
        xx := x
        bomin := math.min(bomin, array.get(plval, x))
    if xx >= mintest and open >= bomin
        for x = 0 to xx by 1
            if array.get(plval, x) >= bomin and array.get(plval, x) <= bomin + chwidth
                num1 := num1 + 1
                bostart1 := array.get(plloc, x)
        if num1 < mintest or lwst <= bomin
            bomin := na

isBreakout = not na(bomax) and num >= mintest
isBreakdown = not na(bomin) and num1 >= mintest

if showBF
    if isBreakout
        line.new(x1 = bar_index, y1 = bomax, x2 = bostart, y2 = bomax, color = bocolorup, style = lstyle)
        line.new(x1 = bar_index, y1 = bomax - chwidth, x2 = bostart, y2 = bomax - chwidth, color = bocolorup, style = lstyle)
        line.new(x1 = bostart, y1 = bomax - chwidth, x2 = bostart, y2 = bomax, color = bocolorup, style = lstyle)
        line.new(x1 = bar_index, y1 = bomax - chwidth, x2 = bar_index, y2 = bomax, color = bocolorup, style = lstyle)

    if isBreakdown
        line.new(x1 = bar_index, y1 = bomin, x2 = bostart1, y2 = bomin, color = bocolordown, style = lstyle)
        line.new(x1 = bar_index, y1 = bomin + chwidth, x2 = bostart1, y2 = bomin + chwidth, color = bocolordown, style = lstyle)
        line.new(x1 = bostart1, y1 = bomin + chwidth, x2 = bostart1, y2 = bomin, color = bocolordown, style = lstyle)
        line.new(x1 = bar_index, y1 = bomin + chwidth, x2 = bar_index, y2 = bomin, color = bocolordown, style = lstyle)

plotshape(showBF and isBreakout, location = location.belowbar, style = shape.triangleup, color = bocolorup, size = size.small)
plotshape(showBF and isBreakdown, location = location.abovebar, style = shape.triangledown, color = bocolordown, size = size.small)

// =============================================================================
// ALERTS
// =============================================================================
alertcondition(triggerBuy, title="Bullish Trend Shift", message="🚨 BULLISH TREND SHIFT: {{ticker}}\nSignal: Confirmed Break Above 200 VWMA.\nPrice: {{close}}")
alertcondition(triggerSell, title="Bearish Trend Shift", message="⚠️ BEARISH TREND SHIFT: {{ticker}}\nSignal: Confirmed Break Below 200 VWMA.\nPrice: {{close}}")
alertcondition(trailExit, title="Adaptive Trail Exit", message="🚨 ADAPTIVE TRAIL EXIT: {{ticker}}\nPrice Crossed Trailing Stop.")
alertcondition(isRanging, title="Market Chopping/Ranging", message="⚪ Market is now RANGING/FLAT. Trend reset.")

if targetReached and enableATRAlerts and barstate.isconfirmed
    alert("ATR Target Reached: " + str.tostring(currentDirectionalPips, "#.##") +
          " pips (" + str.tostring(percentReached, "#.#") + "% of period ATR)",
          alert.freq_once_per_bar)

// Pre-calculate ATR Target Crossovers (Global Scope)
t1_hit_up = ta.crossover(high, upperTarget_1)
t2_hit_up = ta.crossover(high, upperTarget_2)
t3_hit_up = ta.crossover(high, upperTarget_3)
t4_hit_up = ta.crossover(high, upperTarget_4)

t1_hit_dn = ta.crossunder(low, lowerTarget_1)
t2_hit_dn = ta.crossunder(low, lowerTarget_2)
t3_hit_dn = ta.crossunder(low, lowerTarget_3)
t4_hit_dn = ta.crossunder(low, lowerTarget_4)

alertcondition(t1_hit_up, title="Target 1 Hit (Up)", message="ATR target 1 reached (upside)")
alertcondition(t2_hit_up, title="Target 2 Hit (Up)", message="ATR target 2 reached (upside)")
alertcondition(t3_hit_up, title="Target 3 Hit (Up)", message="ATR target 3 reached (upside)")
alertcondition(t4_hit_up, title="Target 4 Hit (Up)", message="ATR target 4 reached (upside)")

alertcondition(t1_hit_dn, title="Target 1 Hit (Down)", message="ATR target 1 reached (downside)")
alertcondition(t2_hit_dn, title="Target 2 Hit (Down)", message="ATR target 2 reached (downside)")
alertcondition(t3_hit_dn, title="Target 3 Hit (Down)", message="ATR target 3 reached (downside)")
alertcondition(t4_hit_dn, title="Target 4 Hit (Down)", message="ATR target 4 reached (downside)")

alertcondition(isBreakout, title = 'Breakout', message = 'Breakout')
alertcondition(isBreakdown, title = 'Breakdown', message = 'Breakdown')
alertcondition(isBreakout or isBreakdown, title = 'Breakout or Breakdown', message = 'Breakout or Breakdown')

// Ehlers Specific Alerts
// Pre-calculate conditions to avoid execution warnings
ehlersCross0Up = ta.crossover(ehlers_sig, 0)
ehlersCross1Up = ta.crossover(ehlers_sig, 1)
ehlersCross0Down = ta.crossunder(ehlers_sig, 0)
ehlersCross1Down = ta.crossunder(ehlers_sig, -1)

alertcondition(ehlersCross1Up, 'Strong Buy Signal (Ehlers)', 'Strong Bullish Change Detected')
alertcondition(ehlersCross1Down, 'Strong Sell Signal (Ehlers)', 'Strong Bearish Change Detected')
alertcondition(ehlersCross0Up, 'Buy Signal (Ehlers)', 'Bullish Change Detected')
alertcondition(ehlersCross0Down, 'Sell Signal (Ehlers)', 'Bearish Change Detected')
alertcondition(ehlersCross0Up or ehlersCross1Up, 'All Buy Signals (Ehlers)', 'Any Bullish Change Detected')
alertcondition(ehlersCross0Down or ehlersCross1Down, 'All Sell Signals (Ehlers)', 'Any Bearish Change Detected')
