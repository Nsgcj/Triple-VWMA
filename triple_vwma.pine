//@version=6
indicator("Triple VWMA & ATR Table", shorttitle="3VWMA+ATR", overlay=true)

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================
getPosition(pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right

getSize(sizeStr) =>
    switch sizeStr
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

// =============================================================================
// TRIPLE VWMA SETTINGS
// =============================================================================

// --- VWMA 1 Settings (Default: 20) ---
grp1 = "VWMA 1"
show1 = input.bool(true, "Show", group=grp1)
len1 = input.int(20, "Length", minval=1, group=grp1)
src1 = input.source(close, "Source", group=grp1)
offset1 = input.int(0, "Offset", minval=-500, maxval=500, group=grp1)
color1 = input.color(color.blue, "Color", group=grp1)

// --- VWMA 2 Settings (Default: 50) ---
grp2 = "VWMA 2"
show2 = input.bool(true, "Show", group=grp2)
len2 = input.int(50, "Length", minval=1, group=grp2)
src2 = input.source(close, "Source", group=grp2)
offset2 = input.int(0, "Offset", minval=-500, maxval=500, group=grp2)
color2 = input.color(color.orange, "Color", group=grp2)

// --- VWMA 3 Settings (Default: 200) ---
grp3 = "VWMA 3"
show3 = input.bool(true, "Show", group=grp3)
len3 = input.int(200, "Length", minval=1, group=grp3)
src3 = input.source(close, "Source", group=grp3)
offset3 = input.int(0, "Offset", minval=-500, maxval=500, group=grp3)
color3 = input.color(color.red, "Color", group=grp3)

// --- Trend Logic & Filters ---
grpTrend = "Trend Logic (VWMA 3)"
useVolFilter = input.bool(false, "Volume Surge Filter (> SMA 10)", group=grpTrend)
useAtrFilter = input.bool(false, "ATR Buffer Filter", group=grpTrend)
atrMult = input.float(0.5, "ATR Multiplier", minval=0.1, step=0.1, group=grpTrend)

// --- MTF Dashboard Settings ---
grpMtf = "MTF Dashboard"
showMtf = input.bool(true, "Show Dashboard", group=grpMtf)
dashPosInput = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grpMtf)
dashTextColor = input.color(color.white, "Text Color", group=grpMtf)
dashBgColor = input.color(color.new(color.gray, 50), "Background Color", group=grpMtf)

tf1 = input.timeframe("60", "Timeframe 1", group=grpMtf)
tf2 = input.timeframe("240", "Timeframe 2", group=grpMtf)
tf3 = input.timeframe("D", "Timeframe 3", group=grpMtf)
tf4 = input.timeframe("W", "Timeframe 4", group=grpMtf)
tf5 = input.timeframe("M", "Timeframe 5", group=grpMtf)

// =============================================================================
// ATR TABLE & ADAPTIVE TRAIL SETTINGS
// =============================================================================
grpAtrDisplay = "ATR Table - Display"
showPrevATR = input.bool(true, title = 'Show Dynamic ATR Analysis Panel', group = grpAtrDisplay)
showATRDirection = input.bool(true, title = 'Show ATR Directional Tracking', group = grpAtrDisplay)
showMultiLevelTargets = input.bool(true, title = 'Show Multi-Level ATR Targets', group = grpAtrDisplay)
atrTablePosition = input.string("Bottom Right", title="ATR Table Position",
    options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"],
    group = grpAtrDisplay)
atrTableSize = input.string("Small", title="ATR Table Text Size",
    options=["Tiny", "Small", "Normal", "Large", "Huge"], group = grpAtrDisplay)

grpAtrLogic = "ATR Table - Logic"
atrLength = input.int(14, title = 'ATR Length', minval = 1, group = grpAtrLogic)
pipMultiplier = input.float(10000, title = 'Pip Multiplier', group = grpAtrLogic,
    tooltip = '10000 for standard forex, 100 for JPY pairs, 1 for crypto', options=[1, 100, 10000])
enableATRAlerts = input.bool(true, title = 'Enable ATR Target Alerts', group = grpAtrLogic)

grpAdaptive = "Adaptive Session Trail"
showAdaptiveTrail = input.bool(true, "Show Adaptive Trail", group=grpAdaptive)
trailMultLow = input.float(3.0, "Early Session Multiplier", group=grpAdaptive)
trailMultMid = input.float(2.5, "Mid Session Multiplier (60-90%)", group=grpAdaptive)
trailMultHigh = input.float(1.5, "Exhaustion Multiplier (>90%)", group=grpAdaptive)

// Session time settings for intraday (Kill Zones)
grpSessions = "Session Settings (EST)"
kzAsia = input.session("2000-0000", title="Asian Kill Zone", group=grpSessions)
kzLondon = input.session("0200-0500", title="London Open Kill Zone", group=grpSessions)
kzNY = input.session("0700-1000", title="NY Open Kill Zone", group=grpSessions)
kzLondonClose = input.session("1000-1200", title="London Close Kill Zone", group=grpSessions)

// =============================================================================
// SOP INFO PANEL SETTINGS
// =============================================================================
grpSop = "SOP Info Panel"
showSop = input.bool(true, "Show SOP Info Panel", group=grpSop)
sopPosInput = input.string("Bottom Left", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grpSop)
sopSizeInput = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grpSop)
sopTextColor = input.color(color.white, "Text Color", group=grpSop)
sopBgColor = input.color(color.new(color.black, 30), "Background Color", group=grpSop)
// Active Row Colors
colorEarly = color.new(color.aqua, 20)
colorLock = color.new(color.lime, 20)
colorExit = color.new(color.red, 20)
colorDim = color.new(color.gray, 70)

// =============================================================================
// TRIPLE VWMA CALCULATIONS
// =============================================================================
vwma1 = ta.vwma(src1, len1)
vwma2 = ta.vwma(src2, len2)
vwma3 = ta.vwma(src3, len3)

plot(show1 ? vwma1 : na, title="VWMA 1", color=color1, offset=offset1)
plot(show2 ? vwma2 : na, title="VWMA 2", color=color2, offset=offset2)
plot(show3 ? vwma3 : na, title="VWMA 3", color=color3, offset=offset3)

// Filter Calculations
volSma = ta.sma(volume, 10)
volOk = not useVolFilter or (volume > volSma)

// ATR Buffer Logic (for VWMA confirmation)
atrValFilter = ta.atr(14)
upperThreshold = useAtrFilter ? vwma3 + (atrValFilter * atrMult) : vwma3
lowerThreshold = useAtrFilter ? vwma3 - (atrValFilter * atrMult) : vwma3

// Trend State & Logic
var int currentTrend = 0
breakUp = open[1] < vwma3[1] and close[1] > vwma3[1]
breakDown = open[1] > vwma3[1] and close[1] < vwma3[1]
confirmUp = close > upperThreshold
confirmDown = close < lowerThreshold

triggerBuy = breakUp and confirmUp and volOk and currentTrend != 1
triggerSell = breakDown and confirmDown and volOk and currentTrend != -1

if triggerBuy
    currentTrend := 1
if triggerSell
    currentTrend := -1

// MTF Dashboard Logic
[mtf1_vwma, mtf1_close] = request.security(syminfo.tickerid, tf1, [ta.vwma(src3, len3), close])
[mtf2_vwma, mtf2_close] = request.security(syminfo.tickerid, tf2, [ta.vwma(src3, len3), close])
[mtf3_vwma, mtf3_close] = request.security(syminfo.tickerid, tf3, [ta.vwma(src3, len3), close])
[mtf4_vwma, mtf4_close] = request.security(syminfo.tickerid, tf4, [ta.vwma(src3, len3), close])
[mtf5_vwma, mtf5_close] = request.security(syminfo.tickerid, tf5, [ta.vwma(src3, len3), close])

isBull1 = mtf1_close > mtf1_vwma
isBull2 = mtf2_close > mtf2_vwma
isBull3 = mtf3_close > mtf3_vwma
isBull4 = mtf4_close > mtf4_vwma
isBull5 = mtf5_close > mtf5_vwma

// VWMA Dashboard Table
dashPos = position.top_right
if dashPosInput == "Top Left"
    dashPos := position.top_left
else if dashPosInput == "Bottom Right"
    dashPos := position.bottom_right
else if dashPosInput == "Bottom Left"
    dashPos := position.bottom_left
else if dashPosInput == "Middle Right"
    dashPos := position.middle_right
else if dashPosInput == "Middle Left"
    dashPos := position.middle_left

if showMtf
    var table mtfTable = table.new(dashPos, 2, 6, border_width=1)
    if barstate.islast
        table.cell(mtfTable, 0, 0, "MTF", bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 1, 0, "Trend", bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 0, 1, tf1, bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 1, 1, isBull1 ? "BULL" : "BEAR", bgcolor=isBull1 ? color.green : color.red, text_color=color.white)
        table.cell(mtfTable, 0, 2, tf2, bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 1, 2, isBull2 ? "BULL" : "BEAR", bgcolor=isBull2 ? color.green : color.red, text_color=color.white)
        table.cell(mtfTable, 0, 3, tf3, bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 1, 3, isBull3 ? "BULL" : "BEAR", bgcolor=isBull3 ? color.green : color.red, text_color=color.white)
        table.cell(mtfTable, 0, 4, tf4, bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 1, 4, isBull4 ? "BULL" : "BEAR", bgcolor=isBull4 ? color.green : color.red, text_color=color.white)
        table.cell(mtfTable, 0, 5, tf5, bgcolor=dashBgColor, text_color=dashTextColor)
        table.cell(mtfTable, 1, 5, isBull5 ? "BULL" : "BEAR", bgcolor=isBull5 ? color.green : color.red, text_color=color.white)

// =============================================================================
// ATR TABLE LOGIC & CALCULATIONS
// =============================================================================
// Helper to check time in timezone
isInSession(sess) => not na(time(timeframe.period, sess, "America/New_York"))

inAsia = isInSession(kzAsia)
inLondon = isInSession(kzLondon)
inNY = isInSession(kzNY)
inLondonClose = isInSession(kzLondonClose)

activeSessionName = "Off-Hours"
if inAsia
    activeSessionName := "Asian Kill Zone"
if inLondon
    activeSessionName := "London Open Kill Zone"
if inNY
    activeSessionName := "NY Open Kill Zone"
if inLondonClose
    activeSessionName := "London Close Kill Zone"

// Session Start & Range Tracking Logic
var float activeSessionOpen = na
var float sessHigh = na
var float sessLow = na
var bool newSess = false
isAnySession = inAsia or inLondon or inNY or inLondonClose
wasAnySession = isAnySession[1]
newSess := activeSessionName != activeSessionName[1] and activeSessionName != "Off-Hours"

if newSess or barstate.isfirst
    activeSessionOpen := open
    sessHigh := high
    sessLow := low
else
    // Freeze behavior: Update only if in session, otherwise hold last known state
    // But script needs to continue calculating exhaustion if 'off-hours' is essentially 'late session'
    // Prompt says: "Freeze on the last known state. The panel should only Reset when the next Kill Zone session officially starts."
    // So we just update high/low on every bar. The 'reset' happens on newSess.
    sessHigh := math.max(nz(sessHigh, high), high)
    sessLow := math.min(nz(sessLow, low), low)

if not isAnySession and not wasAnySession and na(activeSessionOpen)
    activeSessionOpen := open

isMonthly = timeframe.ismonthly
isWeekly = timeframe.isweekly
isDaily = timeframe.isdaily
isIntraday = timeframe.isintraday

getCurrentMinutes() =>
    if timeframe.isminutes
        timeframe.multiplier
    else if timeframe.isseconds
        timeframe.multiplier / 60
    else
        0

currentMinutes = getCurrentMinutes()
isHourly = isIntraday and currentMinutes >= 60 and currentMinutes < 1440
is4Hour = currentMinutes == 240
isMinuteBased = isIntraday and currentMinutes > 0 and currentMinutes < 60

getATRTimeframe() =>
    if isMonthly
        "M"
    else if isWeekly
        "W"
    else if isDaily
        "D"
    else if is4Hour or isHourly
        "240"
    else if isMinuteBased
        timeframe.period
    else
        "D"

atrTimeframe = getATRTimeframe()

// Fetch ATR Data
[periodOpen, periodATR, period_atr_prev, period_atr_current] = request.security(
    syminfo.tickerid,
    atrTimeframe,
    [open, ta.atr(atrLength), ta.atr(atrLength)[1], ta.atr(atrLength)],
    lookahead = barmerge.lookahead_off)

referenceOpen = isAnySession ? activeSessionOpen : periodOpen
referenceATR = periodATR
atrMeanPips = referenceATR * pipMultiplier

// --- NEW Range Based Completion Logic ---
sessionRange = sessHigh - sessLow
// If no session active (first run), fallback to current bar range or 0
if na(sessionRange)
    sessionRange := high - low

// Use Range for exhaustion logic instead of Move From Open
// FIX: We must compare Session Range to DAILY ATR (or a macro metric), not the chart timeframe ATR.
// Comparing Session Range to 5m ATR results in >1000% immediately.
dailyATR = request.security(syminfo.tickerid, "D", ta.atr(14))
sessionRangeCompletion = dailyATR != 0 ? (sessionRange / dailyATR) * 100 : 0

// Original Directional Logic (Kept for ATR Table targets)
moveFromOpen = math.abs(close - referenceOpen)
percentReached = referenceATR != 0 ? (moveFromOpen / referenceATR) * 100 : 0
bullishMove = (close > referenceOpen) ? (close - referenceOpen) * pipMultiplier : 0
bearishMove = (close < referenceOpen) ? (referenceOpen - close) * pipMultiplier : 0
currentDirectionalPips = bullishMove > 0 ? bullishMove : bearishMove

getTargetMultipliers() =>
    if isMonthly
        [0.5, 1.0, 1.5, 2.0]
    else if isWeekly
        [0.5, 0.75, 1.0, 1.5]
    else if isDaily
        [0.5, 0.75, 1.0, 1.5]
    else if isHourly or is4Hour
        [0.3, 0.5, 0.75, 1.0]
    else
        [0.25, 0.5, 0.75, 1.0]

[mult1, mult2, mult3, mult4] = getTargetMultipliers()

upperTarget_1 = referenceOpen + (referenceATR * mult1)
upperTarget_2 = referenceOpen + (referenceATR * mult2)
upperTarget_3 = referenceOpen + (referenceATR * mult3)
upperTarget_4 = referenceOpen + (referenceATR * mult4)

lowerTarget_1 = referenceOpen - (referenceATR * mult1)
lowerTarget_2 = referenceOpen - (referenceATR * mult2)
lowerTarget_3 = referenceOpen - (referenceATR * mult3)
lowerTarget_4 = referenceOpen - (referenceATR * mult4)

targetReached = currentDirectionalPips >= atrMeanPips

// =============================================================================
// ADAPTIVE SESSION TRAIL LOGIC (UPDATED)
// =============================================================================
atrM5 = request.security(syminfo.tickerid, "5", ta.atr(14))
var float trailMult = trailMultLow

// Use sessionRangeCompletion now
if sessionRangeCompletion < 60
    trailMult := trailMultLow
else if sessionRangeCompletion >= 60 and sessionRangeCompletion < 90
    trailMult := trailMultMid
else
    trailMult := trailMultHigh

var float trailPrice = na
if triggerBuy
    trailPrice := low - (atrM5 * trailMult)
else if triggerSell
    trailPrice := high + (atrM5 * trailMult)
else if currentTrend == 1
    peak = high
    calcTrail = peak - (atrM5 * trailMult)
    trailPrice := na(trailPrice) ? calcTrail : math.max(trailPrice, calcTrail)
else if currentTrend == -1
    peak = low
    calcTrail = peak + (atrM5 * trailMult)
    trailPrice := na(trailPrice) ? calcTrail : math.min(trailPrice, calcTrail)

plot(showAdaptiveTrail and currentTrend != 0 ? trailPrice : na, "Adaptive Trail", color=color.orange, style=plot.style_linebr, linewidth=2)

trailExit = (currentTrend == 1 and close < trailPrice) or (currentTrend == -1 and close > trailPrice)

// =============================================================================
// SOP INFO PANEL (UPDATED)
// =============================================================================
sopPos = getPosition(sopPosInput)
sopSize = getSize(sopSizeInput)

// Text Constants (Tooltips)
txtWhyM5 = "Why the 5-Minute (M5) is the Standard\n\n1. The 'Noise' Filter: On a 1-minute chart, a 2.5x ATR is often too tight. A single 'stop hunt' or ICT-style 'Judas Swing' will knock you out before the real session move happens.\n\n2. Response Time: On a 15-minute chart, a 3x ATR trail is often too wide. By the time the price crosses it, you may have given back 50–70% of your session gains.\n\n3. The Logic: The 5-minute ATR captures the immediate momentum of the session. If the price pulls back more than 2.5x the average 5-minute candle size, it usually means the 'order flow' has shifted from a trend to a retracement or reversal."

txtEarly = "ATR % Traveled: 0% – 50%\n\nLogic: Give the trade 'breathing room' to develop during the early Kill Zone.\n\nInterpretation: Market is establishing initial range."
txtLock = "ATR % Traveled: 51% – 85%\n\nLogic: The move is established. Start protecting 'house money.'\n\nInterpretation: Middle of session expansion."
txtExit = "ATR % Traveled: 86% – 100%+\n\nLogic: The 'gas tank' is nearly empty. Tighten up to lock in profit before the session reversal.\n\nInterpretation: Exhaustion risk high."

// Dynamic Colors based on Phase
isEarly = sessionRangeCompletion < 60
isLock = sessionRangeCompletion >= 60 and sessionRangeCompletion < 90
isExit = sessionRangeCompletion >= 90

bgEarly = isEarly ? colorEarly : colorDim
bgLock = isLock ? colorLock : colorDim
bgExit = isExit ? colorExit : colorDim

if showSop
    var table sopTable = table.new(sopPos, 4, 5, border_width=1)
    if barstate.islast
        // Header
        headerTitle = "SOP: Adaptive Trail (" + str.tostring(sessionRangeCompletion, "#.#") + "%)"
        table.cell(sopTable, 0, 0, headerTitle, bgcolor=color.new(color.blue, 30), text_color=sopTextColor, text_size=sopSize, tooltip=txtWhyM5)
        table.merge_cells(sopTable, 0, 0, 3, 0) // Merge header for cleaner title

        // SubHeader
        // Wait, merging messed up columns? No, merge is strictly visual.
        // Let's unmerge to keep columns aligned or re-do structure.
        // Re-doing structure: Header is Row 0. Subheader Row 1. Data Row 2,3,4. Footer Row 5.
        // Existing code had Header + 3 Data + Footer.
        // Let's just put the % in the title cell and keep the columns.
        table.cell(sopTable, 0, 0, headerTitle, bgcolor=color.new(color.blue, 30), text_color=sopTextColor, text_size=sopSize, tooltip=txtWhyM5)
        // Reset merge from previous logic if needed (table.new handles fresh instance usually, but var persists)
        // Actually, merging 0,0 to 3,0 covers the whole top row.
        // But we need the column headers?
        // Let's NOT merge, just update the first cell title and let the others be.
        // Or simpler: Just put % in the title and keep structure.
        table.cell(sopTable, 0, 0, "SOP (" + str.tostring(sessionRangeCompletion, "#") + "%)", bgcolor=color.new(color.blue, 30), text_color=sopTextColor, text_size=sopSize, tooltip=txtWhyM5)
        table.cell(sopTable, 1, 0, "% ATR", bgcolor=color.new(color.blue, 30), text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 2, 0, "Mult", bgcolor=color.new(color.blue, 30), text_color=sopTextColor, text_size=sopSize, tooltip="Base: 5-Minute ATR")
        table.cell(sopTable, 3, 0, "Phase", bgcolor=color.new(color.blue, 30), text_color=sopTextColor, text_size=sopSize)

        // Row 1: Early
        table.cell(sopTable, 0, 1, "Early", bgcolor=bgEarly, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 1, 1, "0-60%", bgcolor=bgEarly, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 2, 1, str.tostring(trailMultLow, "#.0") + "x", bgcolor=bgEarly, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 3, 1, "Breathe", bgcolor=bgEarly, text_color=sopTextColor, text_size=sopSize, tooltip=txtEarly)

        // Row 2: Lock
        table.cell(sopTable, 0, 2, "Lock", bgcolor=bgLock, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 1, 2, "60-90%", bgcolor=bgLock, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 2, 2, str.tostring(trailMultMid, "#.0") + "x", bgcolor=bgLock, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 3, 2, "Protect", bgcolor=bgLock, text_color=sopTextColor, text_size=sopSize, tooltip=txtLock)

        // Row 3: Exhaustion
        table.cell(sopTable, 0, 3, "Exit", bgcolor=bgExit, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 1, 3, ">90%", bgcolor=bgExit, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 2, 3, str.tostring(trailMultHigh, "#.0") + "x", bgcolor=bgExit, text_color=sopTextColor, text_size=sopSize)
        table.cell(sopTable, 3, 3, "Choke", bgcolor=bgExit, text_color=sopTextColor, text_size=sopSize, tooltip=txtExit)

        // Footer
        table.merge_cells(sopTable, 0, 4, 3, 4)
        table.cell(sopTable, 0, 4, "Hover headers for SOP details", bgcolor=color.new(color.gray, 50), text_color=color.new(sopTextColor, 30), text_size=size.tiny)

// =============================================================================
// ATR TABLE DRAWING
// =============================================================================
var table atr_table = showPrevATR ? table.new(getPosition(atrTablePosition), 2, showATRDirection ? (showMultiLevelTargets ? 12 : 8) : 3, border_width=1) : na

if barstate.islast and showPrevATR
    atrSize = getSize(atrTableSize)

    headerText = activeSessionName != "Off-Hours" ? activeSessionName : (isMinuteBased ? str.format("{0}M ATR Analysis", currentMinutes) : "ATR Analysis")

    table.cell(atr_table, 0, 0, headerText, bgcolor = color.new(color.blue, 20), text_color = color.white, text_size = atrSize)
    table.cell(atr_table, 1, 0, "", bgcolor = color.new(color.blue, 20))

    table.cell(atr_table, 0, 1, "Prev Period ATR", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
    table.cell(atr_table, 1, 1, str.format('{0, number, #.#####}', period_atr_prev), bgcolor = color.new(color.black, 10), text_color = color.yellow, text_size = atrSize)

    table.cell(atr_table, 0, 2, "Current ATR", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)

    atr_change = period_atr_current - period_atr_prev
    atr_change_pct = period_atr_prev != 0 ? (atr_change / period_atr_prev) * 100 : 0
    atr_cell_color = atr_change > 0 ? color.new(color.red, 30) : color.new(color.green, 30)

    table.cell(atr_table, 1, 2, str.format('{0, number, #.#####} ({1, number, +#.##;-#.##}%)', period_atr_current, atr_change_pct),
        bgcolor = atr_cell_color, text_color = color.white, text_size = atrSize)

    if showATRDirection
        table.cell(atr_table, 0, 3, str.format("{0}-Period ATR Avg", atrLength), bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
        table.cell(atr_table, 1, 3, str.format('{0, number, #.##} pips', atrMeanPips), bgcolor = color.new(color.blue, 30), text_color = color.white, text_size = atrSize)

        table.cell(atr_table, 0, 4, "Current Direction", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
        direction_color = bullishMove > 0 ? color.new(color.green, 30) : color.new(color.red, 30)
        direction_icon = bullishMove > 0 ? "▲" : "▼"
        table.cell(atr_table, 1, 4, str.format('{0} {1, number, #.##} pips', direction_icon, currentDirectionalPips),
            bgcolor = direction_color, text_color = color.white, text_size = atrSize)

        table.cell(atr_table, 0, 5, "% ATR Reached", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
        pct_color = percentReached >= 100 ? color.new(color.yellow, 30) : percentReached >= 75 ? color.new(color.orange, 30) : percentReached >= 50 ? color.new(color.blue, 30) : color.new(color.gray, 50)
        table.cell(atr_table, 1, 5, str.format('{0, number, #.#}%', percentReached), bgcolor = pct_color, text_color = color.white, text_size = atrSize)

        table.cell(atr_table, 0, 6, "Target Reached?", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
        target_status = targetReached ? "✓ YES" : "✗ NO"
        target_color = targetReached ? color.new(color.green, 30) : color.new(color.gray, 50)
        table.cell(atr_table, 1, 6, target_status, bgcolor = target_color, text_color = color.white, text_size = atrSize)

        if isIntraday and (isHourly or is4Hour)
            table.cell(atr_table, 0, 7, "Active Session", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
            session_color = color.new(color.gray, 50)
            if inNY
                session_color := color.new(color.blue, 30)
            else if inLondon
                session_color := color.new(color.green, 30)
            else if inAsia
                session_color := color.new(color.yellow, 30)
            table.cell(atr_table, 1, 7, activeSessionName, bgcolor = session_color, text_color = color.white, text_size = atrSize)

        if showMultiLevelTargets
            row_offset = (isIntraday and (isHourly or is4Hour)) ? 1 : 0

            bullish_direction = close > referenceOpen
            target_1_hit = bullish_direction ? high >= upperTarget_1 : low <= lowerTarget_1
            target_2_hit = bullish_direction ? high >= upperTarget_2 : low <= lowerTarget_2
            target_3_hit = bullish_direction ? high >= upperTarget_3 : low <= lowerTarget_3
            target_4_hit = bullish_direction ? high >= upperTarget_4 : low <= lowerTarget_4

            table.cell(atr_table, 0, 7 + row_offset, str.format("{0}x ATR Target", mult1), bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
            table.cell(atr_table, 1, 7 + row_offset, target_1_hit ? "✓ HIT" : str.format('{0, number, #.##} pips left',
                bullish_direction ? (upperTarget_1 - close) * pipMultiplier : (close - lowerTarget_1) * pipMultiplier),
                bgcolor = target_1_hit ? color.new(color.green, 40) : color.new(color.gray, 60), text_color = color.white, text_size = atrSize)

            table.cell(atr_table, 0, 8 + row_offset, str.format("{0}x ATR Target", mult2), bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
            table.cell(atr_table, 1, 8 + row_offset, target_2_hit ? "✓ HIT" : str.format('{0, number, #.##} pips left',
                bullish_direction ? (upperTarget_2 - close) * pipMultiplier : (close - lowerTarget_2) * pipMultiplier),
                bgcolor = target_2_hit ? color.new(color.green, 40) : color.new(color.gray, 60), text_color = color.white, text_size = atrSize)

            table.cell(atr_table, 0, 9 + row_offset, str.format("{0}x ATR Target", mult3), bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
            table.cell(atr_table, 1, 9 + row_offset, target_3_hit ? "✓ HIT" : str.format('{0, number, #.##} pips left',
                bullish_direction ? (upperTarget_3 - close) * pipMultiplier : (close - lowerTarget_3) * pipMultiplier),
                bgcolor = target_3_hit ? color.new(color.yellow, 40) : color.new(color.gray, 60), text_color = color.white, text_size = atrSize)

            table.cell(atr_table, 0, 10 + row_offset, str.format("{0}x ATR Target", mult4), bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = atrSize)
            table.cell(atr_table, 1, 10 + row_offset, target_4_hit ? "✓ HIT" : str.format('{0, number, #.##} pips left',
                bullish_direction ? (upperTarget_4 - close) * pipMultiplier : (close - lowerTarget_4) * pipMultiplier),
                bgcolor = target_4_hit ? color.new(color.orange, 40) : color.new(color.gray, 60), text_color = color.white, text_size = atrSize)

// =============================================================================
// ALERTS (VWMA + ATR)
// =============================================================================
alertcondition(triggerBuy, title="Bullish Trend Shift", message="🚨 BULLISH TREND SHIFT: {{ticker}}\nSignal: Confirmed Break Above 200 VWMA.\nPrice: {{close}}")
alertcondition(triggerSell, title="Bearish Trend Shift", message="⚠️ BEARISH TREND SHIFT: {{ticker}}\nSignal: Confirmed Break Below 200 VWMA.\nPrice: {{close}}")
alertcondition(trailExit, title="Adaptive Trail Exit", message="🚨 ADAPTIVE TRAIL EXIT: {{ticker}}\nPrice Crossed Trailing Stop.\nExhaustion: {{plot('Adaptive Trail')}}")

if targetReached and enableATRAlerts and barstate.isconfirmed
    alert("ATR Target Reached: " + str.tostring(currentDirectionalPips, "#.##") +
          " pips (" + str.tostring(percentReached, "#.#") + "% of period ATR)",
          alert.freq_once_per_bar)

alertcondition(ta.crossover(high, upperTarget_1), title="Target 1 Hit (Up)", message="ATR target 1 reached (upside)")
alertcondition(ta.crossover(high, upperTarget_2), title="Target 2 Hit (Up)", message="ATR target 2 reached (upside)")
alertcondition(ta.crossover(high, upperTarget_3), title="Target 3 Hit (Up)", message="ATR target 3 reached (upside)")
alertcondition(ta.crossover(high, upperTarget_4), title="Target 4 Hit (Up)", message="ATR target 4 reached (upside)")

alertcondition(ta.crossunder(low, lowerTarget_1), title="Target 1 Hit (Down)", message="ATR target 1 reached (downside)")
alertcondition(ta.crossunder(low, lowerTarget_2), title="Target 2 Hit (Down)", message="ATR target 2 reached (downside)")
alertcondition(ta.crossunder(low, lowerTarget_3), title="Target 3 Hit (Down)", message="ATR target 3 reached (downside)")
alertcondition(ta.crossunder(low, lowerTarget_4), title="Target 4 Hit (Down)", message="ATR target 4 reached (downside)")
